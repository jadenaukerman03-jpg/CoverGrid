# Copy this file to .env and fill in the blanks.
# On Lovable Cloud these values are injected automatically at runtime, so a local
# .env is only needed when you run or host the app somewhere else.
#
# Nothing in this file is a real credential. See SECRETS.md for where each value
# comes from and which ones are required.

# --- Backend (Lovable Cloud / Supabase) -------------------------------------
# Project reference, e.g. "abcdefghijklmnop".
SUPABASE_PROJECT_ID=
SUPABASE_URL=
# Publishable (public) key. Safe to commit in principle, still kept blank here.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Server-only admin key. Never expose to the browser, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Same three values the browser build reads (must keep the VITE_ prefix).
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- AI (Lovable AI Gateway) -------------------------------------------------
# Server-only. Powers the scheduling assistant and the background autopilot.
LOVABLE_API_KEY=

# --- Texting (Twilio) --------------------------------------------------------
# Required only if you want staff to claim open shifts by text and the system to
# send SMS alerts. All three are needed together.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
